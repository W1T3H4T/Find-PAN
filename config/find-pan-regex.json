{
    "Notes": {
        "PAN Regex Info": [
            "To support 'make-test-pan.py' and 'make-test-track.py', REGEX patterns",
            "should conform to this pattern:  ",
            "(prefix)[0-9]{len}",
            "",
            "The 'prefix' should be of equal lengths to support {len} such that the sum of",
            "both equals the number of digits (length) of the PAN matched by the pattern. ",
            "There should be only ONE length per pattern.",
            "",
            "Use the 'Length': NN keyword to describe all lengths of the PAN being matched ",
            "by all of the patterns in the 'regex': [ array ]"
        ],
        "Delimited PAN Info": [
            "'Delimited PAN Pattern' entries are not matchers.  They only find PANs written in groups",
            "joined by one repeated space or hyphen (4556-7375-8689-9855).  Each found group is",
            "compacted (separators removed) BEFORE the Anti-PAN and PAN patterns run, so those patterns",
            "decide what is a PAN.  TRACK patterns always see the original text."
        ]
    },
    "Delimited PAN Pattern": {
        "4-4-4-n": {
            "regex": [
                "(?<![0-9])[0-9]{4}([ -])[0-9]{4}\\1[0-9]{4}\\1[0-9]{1,7}(?![0-9])"
            ],
            "length": "13-19"
        },
        "4-4-4-4-n": {
            "regex": [
                "(?<![0-9])[0-9]{4}([ -])[0-9]{4}\\1[0-9]{4}\\1[0-9]{4}\\1[0-9]{1,3}(?![0-9])"
            ],
            "length": "17-19"
        },
        "4-6-5": {
            "regex": [
                "(?<![0-9])[0-9]{4}([ -])[0-9]{6}\\1[0-9]{5}(?![0-9])"
            ],
            "length": "15"
        },
        "4-6-4": {
            "regex": [
                "(?<![0-9])[0-9]{4}([ -])[0-9]{6}\\1[0-9]{4}(?![0-9])"
            ],
            "length": "14"
        }
    },
    "Anti-PAN Pattern": {
        "Timestamp": {
            "regex": [
                "(?<![0-9])(?:19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])(?:[01][0-9]|2[0-3])[0-5][0-9][0-5][0-9](?![0-9])"
            ],
            "length": "14"
        },
        "Sequential Numbers": {
            "regex": [ 
                "(123456|654321)[0-9]{12,19}"
            ],
            "length": "19"
        },
        "Repeated Numbers": {
            "regex": [
                "([3456][0-9]{3,5})\\1+"
            ],
            "length": "19"
        },
        "Repeated Numbers Extended": {
            "regex": [ 
                "[34356]([0-9])\\1{2}(([0-9]([0-9])\\1{2}){2})"
            ],
            "length": "19"
        },
        "654321 with Trailing Zeros": {
            "regex": [ 
                "(?=.{12,19}$)6?5?4321[0]+" 
            ],
            "length": "19"
        }
    },
    "TRACK Pattern": {
        "Track 1": {
            "regex": [
                "%[BM][0-9]{12,19}[\\^][A-Za-z0-9/,]+[\\^][0-9]+[\\?]" 
            ],
            "length": "12-24"
        },
        "Track 2": {
            "regex": [ 
                ";[0-9]{12,19}=[0-9]+[\\?]" 
            ],
            "length": "12-24"
        }
    },
    "PAN Pattern": {
        "American Express": {
            "regex": [
                "(?<![0-9])(?:34|37)[0-9]{13}(?![0-9])"
            ],
            "length": "15"
        },
        "Diners Club Carte Blanche": {
            "regex": [
                "(?<![0-9])30[0-5][0-9]{11}(?![0-9])"
            ],
            "length": "14"
        },
        "Diners Club International": {
            "regex": [
                "(?<![0-9])(?:30|36|38|39)[0-9]{12,17}(?![0-9])"
            ],
            "length": "14-19"
        },
        "Diners Club US and Canada": {
            "regex": [
                "(?<![0-9])55[0-9]{14}(?![0-9])"
            ],
            "length": "16"
        },
        "Discover Card": {
            "regex": [
                "(?<![0-9])(?:6011[0-9]{12,15}|64[4-9][0-9]{13,16}|65[0-9]{14,17}|622(?:12[6-9]|1[3-9][0-9]|[2-8][0-9]{2}|9[01][0-9]|92[0-5])[0-9]{10,13})(?![0-9])"
            ],
            "length": "16-19"
        },
        "InstaPayment": {
            "regex": [
                "(637|638|639)[0-9]{13}"
            ],
            "length": "16"
        },
        "JCB": {
            "regex": [
                "(?<![0-9])35(?:2[89]|[3-8][0-9])[0-9]{12,15}(?![0-9])"
            ],
            "length": "16-19"
        },
        "Laser": {
            "regex": [
                "(6304|670[69]|6771|6709)[0-9]{12,15}"
            ],
            "length": "16-19"
        },
        "Maestro": {
            "regex": [
                "(?<![0-9])(?:5018|5020|5038|5893|6304|6759|676[1-3])[0-9]{8,15}(?![0-9])"
            ],
            "length": "12-19"
        },
        "Mastercard": {
            "regex": [
                "(?<![0-9])(?:5[1-5][0-9]{14}|222[1-9][0-9]{12}|22[3-9][0-9]{13}|2[3-6][0-9]{14}|27[01][0-9]{13}|2720[0-9]{12})(?![0-9])"
            ],
            "length": "16"
        },
        "VISA": {
            "regex": [
                "(?<![0-9])4(?!026|508|844|913|917|17500)(?:[0-9]{12}|[0-9]{15}|[0-9]{18})(?![0-9])"
            ],
            "length": "13, 16, 19"
        },
        "VISA Electron": {
            "regex": [
                "(?<![0-9])(?:4026|4508|4844|4913|4917)[0-9]{12}(?![0-9])",
                "(?<![0-9])417500[0-9]{10}(?![0-9])"
            ],
            "length": "16"
        },
        "UnionPay": {
            "regex": [
                "(?<![0-9])62[0-9]{14,17}(?![0-9])"
            ],
            "length": "16-19"
        }
    }
}


